{
  "name": "@ofi/ledger-cli",
  "version": "1.0.2",
  "description": "CLI tools to download OFi / Open Collective transactions and convert them to hledger journals",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ofi-balance-download": "balance-download.js",
    "ofi-csv-download": "csv-download.js",
    "ofi-hledger": "hledger.js",
    "ofi-hledger-convert": "hledger-convert.js",
    "ofi-ledger-cli-init": "ledger-cli-init.js"
  },
  "files": [
    "docs/",
    "balance-download.js",
    "csv-download.js",
    "hledger-convert.js",
    "hledger.js",
    "ledger-cli-init.js",
    "rules-base.js"
  ],
  "scripts": {
    "depcheck": "npx @opencollective/depcheck .",
    "graphql:update": "curl https://raw.githubusercontent.com/opencollective/opencollective-frontend/main/lib/graphql/schemaV2.graphql --output graphql/schemaV2.graphql && prettier graphql/schemaV2.graphql --write",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "prettier": "prettier \"**/*.@(js|json|md|graphql)\"",
    "prettier:check": "npm run prettier -- --check && prettier-package-json --list-different",
    "prettier:write": "npm run prettier -- --write && prettier-package-json --write"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^18.0.1",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@graphql-eslint/eslint-plugin": "^4.4.1",
    "eslint": "^10.11.0",
    "eslint-config-opencollective": "^7.1.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "prettier-package-json": "^2.8.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "publishConfig": {
    "access": "public"
  },
  "@opencollective/depcheck": {
    "ignores": [
      "eslint-import-resolver-typescript",
      "graphql",
      "typescript-eslint"
    ]
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,graphql}": [
      "prettier --write"
    ],
    "package.json": [
      "prettier-package-json --write"
    ]
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
